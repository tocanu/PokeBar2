<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Versao do app â€” atualize antes de cada release -->
    <Version>1.0.7</Version>
    <AssemblyVersion>1.0.7.0</AssemblyVersion>
    <FileVersion>1.0.7.0</FileVersion>
    <Product>PokeBar</Product>
    <Company>PokeBar</Company>
    <Description>Desktop Pet Pokemon para Windows</Description>
    <Copyright>Copyright 2025 PokeBar</Copyright>
    <ApplicationIcon>pokeball.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pokebar.Core\Pokebar.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="locale\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- Arquivo de offsets dos sprites necessario em runtime -->
  <ItemGroup>
    <None Include="..\Assets\Final\pokemon_offsets_runtime.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets\Final\pokemon_offsets_runtime.json</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Fonts\PressStart2P-Regular.ttf" />
  </ItemGroup>
</Project>