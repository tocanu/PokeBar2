<Window x:Class="Pokebar.DesktopPet.PokedexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pokebar — Pokédex"
        Width="480" Height="520"
        Style="{StaticResource FR_Window}"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="OnWindowDrag">

    <Border Style="{StaticResource FR_OuterFrame}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <Border Grid.Row="0" Style="{StaticResource FR_HeaderBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="POKÉDEX"
                                   Style="{StaticResource FR_Title}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="✕"
                            Style="{StaticResource FR_ArrowButton}"
                            Click="OnClose" Margin="0,0,4,0"
                            ToolTip="Fechar"/>
                </Grid>
            </Border>

            <!-- ═══ STATS BAR ═══ -->
            <Border Grid.Row="1"
                    Background="{StaticResource FR_BgMediumBrush}"
                    Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vistos -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👁 " Foreground="{StaticResource FR_TextLightBrush}" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="SeenCount" Text="0"
                                   Foreground="{StaticResource FR_AccentGoldBrush}"
                                   FontFamily="{StaticResource FR_PixelFont}" FontSize="9"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="vistos"
                                   Foreground="{StaticResource FR_TextLightBrush}"
                                   FontFamily="{StaticResource FR_PixelFont}" FontSize="7"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Capturados -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⬛ " Foreground="{StaticResource FR_TextLightBrush}" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CapturedCount" Text="0"
                                   Foreground="{StaticResource FR_AccentGreenBrush}"
                                   FontFamily="{StaticResource FR_PixelFont}" FontSize="9"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="capturados"
                                   Foreground="{StaticResource FR_TextLightBrush}"
                                   FontFamily="{StaticResource FR_PixelFont}" FontSize="7"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Barra de progresso geral -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="80">
                        <ProgressBar x:Name="ProgressBar"
                                     Height="8" Minimum="0" Maximum="1025"
                                     Foreground="{StaticResource FR_AccentGreenBrush}"
                                     Background="{StaticResource FR_BgDarkBrush}"
                                     BorderBrush="{StaticResource FR_BorderDarkBrush}"
                                     BorderThickness="1"/>
                        <TextBlock x:Name="ProgressText" Text="0 / 1025"
                                   Foreground="{StaticResource FR_TextMutedBrush}"
                                   FontFamily="{StaticResource FR_PixelFont}" FontSize="6"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ FILTROS ═══ -->
            <Border Grid.Row="2" Style="{StaticResource FR_InnerPanel}" Margin="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filtro -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,4,6">
                        <TextBlock Text="Filtro:"
                                   Foreground="{StaticResource FR_TextDarkBrush}"
                                   FontFamily="{StaticResource FR_PixelFont}" FontSize="7"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton x:Name="FilterAll" Content="Todos"
                                     Style="{StaticResource FR_RadioButton}"
                                     IsChecked="True" Checked="OnFilterChanged"
                                     Margin="0,0,8,0"/>
                        <RadioButton x:Name="FilterSeen" Content="Vistos"
                                     Style="{StaticResource FR_RadioButton}"
                                     Checked="OnFilterChanged"
                                     Margin="0,0,8,0"/>
                        <RadioButton x:Name="FilterCaptured" Content="Capturados"
                                     Style="{StaticResource FR_RadioButton}"
                                     Checked="OnFilterChanged"/>
                    </StackPanel>

                    <!-- Lista de Pokémon -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DexList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"
                                               ItemWidth="86" ItemHeight="96"
                                               Margin="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Cada card de Pokémon -->
                                    <Border Margin="2" Padding="4"
                                            CornerRadius="3"
                                            Background="{Binding CardBackground}"
                                            BorderBrush="{Binding CardBorder}"
                                            BorderThickness="1.5"
                                            ToolTip="{Binding Tooltip}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <!-- Sprite ou silhueta -->
                                            <Border Width="48" Height="48"
                                                    HorizontalAlignment="Center"
                                                    Background="Transparent">
                                                <Image Source="{Binding Sprite}"
                                                       Width="48" Height="48"
                                                       Opacity="{Binding SpriteOpacity}"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       SnapsToDevicePixels="True"/>
                                            </Border>

                                            <!-- Número da Pokédex -->
                                            <TextBlock Text="{Binding DexLabel}"
                                                       FontFamily="{StaticResource FR_PixelFont}"
                                                       FontSize="6"
                                                       Foreground="{Binding DexColor}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0"/>

                                            <!-- Status: visto / capturado -->
                                            <TextBlock Text="{Binding StatusIcon}"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,1,0,0"
                                                       ToolTip="{Binding StatusLabel}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ═══ FOOTER ═══ -->
            <Border Grid.Row="3"
                    Background="{StaticResource FR_BgDarkBrush}"
                    Padding="10,6">
                <TextBlock x:Name="FooterText"
                           Text="Explore o mundo para descobrir novos Pokémon!"
                           Foreground="{StaticResource FR_TextMutedBrush}"
                           FontFamily="{StaticResource FR_PixelFont}"
                           FontSize="6"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Border>
</Window>
